# Артефакты браузерных агентов
.playwright-mcp/
*.log

# Зависимости
node_modules/

# Секреты и сертификаты
.env
certs/*.pem
certs/*.cer

# Скачанные данные (перечень 8 МБ, адресный реестр — большие, качаются заново)
data/*.pdf
data/*.json

# Логи прогонов
logs/

# Сырые выгрузки разведки в docs/ (промежуточные ответы API, пересобираются)
docs/_*

# Мусор разведки: временные зонды и сохранённые ответы API
cat.json
diag_*.mjs
tmp_*.mjs
yandex_budget.json
yandex_cache.json
